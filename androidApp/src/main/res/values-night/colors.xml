    #A39F97 is 7.1:1. Raised and stroke are new neutrals between the two.
-->
<resources>
    <color name="hnm_widget_surface">#141210</color>
    <color name="hnm_widget_raised">#1E1B18</color>
    <color name="hnm_widget_stroke">#34302A</color>
    <color name="hnm_widget_ink">#DDDBD6</color>
    <color name="hnm_widget_ink_dim">#A39F97</color>
    <color name="hnm_widget_ripple">#33FFFFFF</color>
</resources>
