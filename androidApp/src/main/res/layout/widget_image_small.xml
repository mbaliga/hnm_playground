<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:tint="@color/hnm_widget_ink"
        android:contentDescription="@string/widget_shape_label" />

    <TextView
        android:id="@+id/image_empty"
        style="@style/HnmWidget.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/widget_shape_empty_short"
        android:visibility="gone"
        android:layout_weight="1"
        android:maxLines="2"
        android:gravity="center_vertical" />
</LinearLayout>
