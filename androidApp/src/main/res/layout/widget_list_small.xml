<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/list_header"
        style="@style/HnmWidget.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hnm_widget_header"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp" />

    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/hnm_widget_touch"
        android:background="@drawable/hnm_widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row0_title"
                style="@style/HnmWidget.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/row0_meta"
                style="@style/HnmWidget.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/row0_trailing"
            style="@style/HnmWidget.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/list_empty"
        style="@style/HnmWidget.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_weight="1"
        android:maxLines="4"
        android:gravity="center_vertical" />
</LinearLayout>
