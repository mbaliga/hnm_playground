<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="@dimen/hnm_widget_padding"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="@dimen/hnm_widget_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_label"
            style="@style/HnmWidget.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_daily_label" />

        <TextView
            android:id="@+id/card_title"
            style="@style/HnmWidget.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_heartbeat"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/card_body"
            style="@style/HnmWidget.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_daily_body"
            android:layout_marginTop="2dp"
            android:maxLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_feel"
        style="@style/HnmWidget.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_daily_feel"
        android:layout_marginStart="8dp" />
</LinearLayout>
