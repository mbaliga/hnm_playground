<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/pad0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/hnm_widget_touch"
        android:background="@drawable/hnm_widget_pad_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/pad0_glyph"
            style="@style/HnmWidget.Text.Glyph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/pad0_label"
            style="@style/HnmWidget.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pad1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/hnm_widget_touch"
        android:layout_marginTop="@dimen/hnm_widget_gap"
        android:background="@drawable/hnm_widget_pad_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/pad1_glyph"
            style="@style/HnmWidget.Text.Glyph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/pad1_label"
            style="@style/HnmWidget.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center" />
    </LinearLayout>
</LinearLayout>
