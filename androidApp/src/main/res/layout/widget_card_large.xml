<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="@dimen/hnm_widget_padding"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="@dimen/hnm_widget_padding">

    <TextView
        android:id="@+id/card_label"
        style="@style/HnmWidget.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_daily_label" />

    <TextView
        android:id="@+id/card_title"
        style="@style/HnmWidget.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/card_body"
        style="@style/HnmWidget.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2" />

    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY"
        android:tint="@color/hnm_widget_ink"
        android:contentDescription="@string/widget_daily_label" />

    <TextView
        android:id="@+id/card_meta"
        style="@style/HnmWidget.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_open"
            style="@style/HnmWidget.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_daily_open" />

        <TextView
            android:id="@+id/card_feel"
            style="@style/HnmWidget.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_daily_feel"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
