<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="@dimen/hnm_widget_padding"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="@dimen/hnm_widget_padding">

    <TextView
        android:id="@+id/loading_text"
        style="@style/HnmWidget.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_loading"
        android:layout_gravity="center" />
</FrameLayout>
