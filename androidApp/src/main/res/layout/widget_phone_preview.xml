<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnm_widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hnm_widget_padding"
    android:paddingTop="@dimen/hnm_widget_padding"
    android:paddingEnd="@dimen/hnm_widget_padding"
    android:paddingBottom="@dimen/hnm_widget_padding">

    <TextView
        android:id="@+id/stat_header"
        style="@style/HnmWidget.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_phone_header" />

    <TextView
        android:id="@+id/stat_value"
        style="@style/HnmWidget.Text.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_phone_value"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/stat_label"
        style="@style/HnmWidget.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_phone_primitives" />

    <TextView
        android:id="@+id/stat_caption"
        style="@style/HnmWidget.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_phone_tier_primitives"
        android:layout_marginTop="2dp"
        android:maxLines="2" />
</LinearLayout>
